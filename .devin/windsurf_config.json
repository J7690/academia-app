{
    "version": "1.0.0",
    "name": "Windsurf Rules Enforcer",
    "description": "Système obligatoire d'application des règles Windsurf",
    "auto_load": true,
    "mandatory": true,
    "rules": {
        "selection_agent": {
            "enabled": true,
            "automatic": true,
            "no_manual_override": true
        },
        "audit_systematic": {
            "enabled": true,
            "before_execution": true,
            "flutter_required": true,
            "supabase_required": true,
            "integration_required": true
        },
        "validation_workflow": {
            "enabled": true,
            "user_confirmation_required": true,
            "no_auto_execution": true,
            "detailed_proposal": true
        },
        "zero_assumption": {
            "enabled": true,
            "physical_verification": true,
            "no_deduction": true,
            "explicit_validation": true
        },
        "continuous_monitoring": {
            "enabled": true,
            "during_execution": true,
            "post_execution": true,
            "error_tracking": true
        }
    },
    "enforcement": {
        "startup_required": true,
        "task_interception": true,
        "rule_validation": true,
        "failure_action": "stop_execution",
        "logging": true,
        "debug_mode": false
    },
    "paths": {
        "rules_directory": ".windsurf/",
        "required_files": [
            "rules.md",
            "procedures.md",
            "intelligent_agent_selection.md",
            "audit_protocols.md",
            "validation_workflow.md",
            "windsurf_shortcuts.md",
            "auto_load_system.md",
            "__init__.py",
            "startup.py"
        ],
        "startup_script": ".windsurf/startup.py"
    },
    "agents": {
        "flutter_ui_agent": {
            "scope": ["ui", "widgets", "layout", "themes"],
            "priority": 1
        },
        "supabase_db_agent": {
            "scope": ["database", "tables", "functions", "auth"],
            "priority": 2
        },
        "integration_agent": {
            "scope": ["api", "connections", "data_flow"],
            "priority": 3
        },
        "system_architect_agent": {
            "scope": ["architecture", "patterns", "complex_tasks"],
            "priority": 4
        }
    },
    "audit_checklist": {
        "flutter": [
            "scan_project_structure",
            "verify_dependencies",
            "check_ui_components",
            "validate_services"
        ],
        "supabase": [
            "list_tables",
            "verify_functions",
            "check_auth_schemas",
            "validate_policies"
        ],
        "integration": [
            "test_api_endpoints",
            "verify_data_types",
            "check_security",
            "validate_connections"
        ]
    }
}
