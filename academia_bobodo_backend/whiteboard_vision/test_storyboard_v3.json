 "scenes": [
  {
   "id": "scene-001",
   "order": 0,
   "title": "Introduction",
   "duration_ms": 6000,
   "blocks": [
    {
     "id": "b-001",
     "type": "title",
     "content": "Équations du second degré",
     "order": 0,
     "visible": true
    },
    {
     "id": "b-002",
     "type": "paragraph",
     "content": "Une équation du second degré est une équation polynomiale de la forme ax² + bx + c = 0, où a, b et c sont des constantes réelles avec a ≠ 0.",
     "order": 1,
     "visible": true
    },
    {
     "id": "b-003",
     "type": "formula",
     "content": "ax^2 + bx + c = 0 \\quad (a \\neq 0)",
     "order": 2,
     "visible": true
    }
   ],
   "beat": "hook"
  },
  {
   "id": "scene-002",
   "order": 1,
   "title": "Le discriminant",
   "duration_ms": 7000,
   "blocks": [
    {
     "id": "b-004",
     "type": "title",
     "content": "Le Discriminant Δ",
     "order": 0,
     "visible": true
    },
    {
     "id": "b-005",
     "type": "definition",
     "content": "Le discriminant d'une équation du second degré ax² + bx + c = 0 est le nombre réel Δ = b² - 4ac. Il détermine la nature des solutions.",
     "order": 1,
     "visible": true,
     "key_words": [
      "discriminant"
     ]
    },
    {
     "id": "b-006",
     "type": "formula",
     "content": "\\Delta = b^2 - 4ac",
     "order": 2,
     "visible": true
    },
    {
     "id": "b-007",
     "type": "paragraph",
     "content": "• Si Δ > 0 : deux solutions réelles distinctes\n• Si Δ = 0 : une solution réelle double\n• Si Δ < 0 : aucune solution réelle",
     "order": 3,
     "visible": true
    }
   ]
  },
  {
   "id": "scene-003",
   "order": 2,
   "title": "Formule des solutions",
   "duration_ms": 6000,
   "blocks": [
    {
     "id": "b-008",
     "type": "title",
     "content": "Formule de résolution",
     "order": 0,
     "visible": true
    },
    {
     "id": "b-009",
     "type": "formula",
     "content": "x = \\frac{-b \\pm \\sqrt{\\Delta}}{2a}",
     "order": 1,
     "visible": true
    },
    {
     "id": "b-010",
     "type": "paragraph",
     "content": "Les deux solutions, quand elles existent (Δ ≥ 0), sont :",
     "order": 2,
     "visible": true
    },
    {
     "id": "b-011",
     "type": "formula",
     "content": "x_1 = \\frac{-b - \\sqrt{\\Delta}}{2a} \\qquad x_2 = \\frac{-b + \\sqrt{\\Delta}}{2a}",
     "order": 3,
     "visible": true
    }
   ]
  },
  {
   "id": "scene-004",
   "order": 3,
   "title": "Exercice",
   "duration_ms": 8000,
   "blocks": [
    {
     "id": "b-012",
     "type": "title",
     "content": "Exercice d'application",
     "order": 0,
     "visible": true
    },
    {
     "id": "b-013",
     "type": "exercise",
     "content": "Résoudre l'équation suivante dans ℝ :\n2x² - 5x + 3 = 0",
     "order": 1,
     "visible": true
    },
    {
     "id": "b-014",
     "type": "correction",
     "content": "On identifie a=2, b=-5, c=3\nCalcul du discriminant : Δ = (-5)² - 4(2)(3) = 25 - 24 = 1\nΔ = 1 > 0 donc deux solutions réelles\nx₁ = (5 - 1) / 4 = 1\nx₂ = (5 + 1) / 4 = 3/2\nS = {1 ; 3/2}",
     "order": 2,
     "visible": true
    }
   ]
  },
  {
   "id": "rec",
   "order": 4,
   "title": "A retenir",
   "duration_ms": 9000,
   "beat": "recap",
   "narration": "Recapitulons.",
   "transition": {
    "kind": "fade"
   },
   "blocks": [
