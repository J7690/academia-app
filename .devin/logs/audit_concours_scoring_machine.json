  "queue_notif_fn": {
    "ok": true,
    "mode": "select",
    "rows": [
      {
        "def": "CREATE OR REPLACE FUNCTION public.app_queue_notification_event(p_user_id uuid, p_domain text, p_event_type text, p_payload jsonb)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    IF p_user_id IS NULL THEN\n        RETURN;\n    END IF;\n\n    IF p_domain IS NULL OR LENGTH(TRIM(p_domain)) = 0 THEN\n        RETURN;\n    END IF;\n\n    INSERT INTO app.notification_events (user_id, domain, event_type, payload)\n    VALUES (p_user_id, p_domain, p_event_type, COALESCE(p_payload, '{}'::JSONB));\nEND;\n$function$\n"
      }
    ]
  }
