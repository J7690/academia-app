  "all_financial_rls": [
    {
      "cmd": "SELECT",
      "qual": "((auth.jwt() ? 'role'::text) AND ((auth.jwt() ->> 'role'::text) = 'admin'::text))",
      "roles": [
        "public"
      ],
      "tablename": "application_payments",
      "permissive": "PERMISSIVE",
      "policyname": "admin_select_all_payments",
      "schemaname": "app"
    },
    {
      "cmd": "SELECT",
      "qual": "(student_id = auth.uid())",
      "roles": [
        "public"
      ],
      "tablename": "application_payments",
      "permissive": "PERMISSIVE",
      "policyname": "student_select_own_payments",
      "schemaname": "app"
    },
    {
      "cmd": "SELECT",
      "qual": "\nCASE\n    WHEN ((auth.jwt() ? 'role'::text) AND ((auth.jwt() ->> 'role'::text) = 'university'::text)) THEN (((auth.jwt() ->> 'university_id'::text))::uuid = university_id)\n    ELSE false\nEND",
      "roles": [
        "public"
      ],
      "tablename": "application_payments",
      "permissive": "PERMISSIVE",
      "policyname": "university_select_own_payments",
      "schemaname": "app"
    },
    {
      "cmd": "SELECT",
      "qual": "((auth.jwt() ? 'role'::text) AND ((auth.jwt() ->> 'role'::text) = 'admin'::text))",
      "roles": [
        "public"
      ],
      "tablename": "commercial_profiles",
      "permissive": "PERMISSIVE",
      "policyname": "admin_select_commercial_profiles",
      "schemaname": "app"
    },
    {
      "cmd": "SELECT",
      "qual": "(user_id = auth.uid())",
      "roles": [
        "public"
      ],
      "tablename": "commercial_profiles",
      "permissive": "PERMISSIVE",
      "policyname": "commercial_select_own_profile",
      "schemaname": "app"
    },
    {
      "cmd": "INSERT",
      "qual": null,
      "roles": [
        "authenticated"
      ],
      "tablename": "marketplace_listings",
      "permissive": "PERMISSIVE",
      "policyname": "merchant_insert_own_marketplace_listings",
      "schemaname": "app"
    },
    {
      "cmd": "SELECT",
