  "scenes": [
    {
      "id": "scene-001",
      "order": 0,
      "title": "Introduction aux Dérivées",
      "blocks": [
        {
          "id": "block-001",
          "type": "title",
          "order": 0,
          "style": {},
          "content": "Qu'est-ce qu'une dérivée ?",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-002",
          "type": "paragraph",
          "order": 1,
          "style": {},
          "content": "La dérivée d'une fonction mesure la vitesse à laquelle la valeur de la fonction change par rapport à un changement de sa variable.",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-003",
          "type": "paragraph",
          "order": 2,
          "style": {},
          "content": "C'est un concept fondamental en calcul différentiel.",
          "visible": true,
          "position": {},
          "animation": {}
        }
      ],
      "transition": {},
      "duration_ms": 7000
    },
    {
      "id": "scene-002",
      "order": 1,
      "title": "Définition Formelle",
      "blocks": [
        {
          "id": "block-004",
          "type": "definition",
          "order": 0,
          "style": {},
          "content": "La dérivée d'une fonction f en un point x, notée f'(x), est la limite du taux de variation moyen lorsque le pas tend vers zéro.",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-005",
          "type": "formula",
          "order": 1,
          "style": {},
          "content": "f'(x) = \\lim_{h \\to 0} \\frac{f(x+h) - f(x)}{h}",
          "visible": true,
          "position": {},
          "animation": {}
        }
      ],
      "transition": {},
      "duration_ms": 8000
    },
    {
      "id": "scene-003",
      "order": 2,
      "title": "Interprétation Géométrique",
      "blocks": [
        {
          "id": "block-006",
          "type": "paragraph",
          "order": 0,
          "style": {},
          "content": "Géométriquement, la dérivée f'(x) représente la pente de la tangente à la courbe de f au point (x, f(x)).",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-007",
          "type": "paragraph",
          "order": 1,
          "style": {},
          "content": "Elle indique la direction et la raideur de la courbe à cet endroit.",
          "visible": true,
          "position": {},
          "animation": {}
        }
      ],
      "transition": {},
      "duration_ms": 6000
    },
    {
      "id": "scene-004",
      "order": 3,
      "title": "Exemple Simple : Fonction Linéaire",
      "blocks": [
        {
          "id": "block-008",
          "type": "paragraph",
          "order": 0,
          "style": {},
          "content": "Considérons la fonction f(x) = 3x + 2.",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-009",
          "type": "paragraph",
          "order": 1,
          "style": {},
          "content": "La pente de cette droite est constante.",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-010",
          "type": "formula",
          "order": 2,
          "style": {},
          "content": "f'(x) = 3",
          "visible": true,
          "position": {},
          "animation": {}
        }
      ],
      "transition": {},
      "duration_ms": 7000
    },
    {
      "id": "scene-005",
      "order": 4,
      "title": "Exemple : Fonction Quadratique",
      "blocks": [
        {
          "id": "block-011",
          "type": "paragraph",
          "order": 0,
          "style": {},
          "content": "Calculons la dérivée de f(x) = x².",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-012",
          "type": "formula",
          "order": 1,
          "style": {},
          "content": "\\frac{d}{dx}(x^n) = nx^{n-1}",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-013",
          "type": "formula",
          "order": 2,
          "style": {},
          "content": "f'(x) = 2x^{2-1} = 2x",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-014",
          "type": "paragraph",
          "order": 3,
          "style": {},
          "content": "La pente de la tangente varie selon x.",
          "visible": true,
          "position": {},
          "animation": {}
        }
      ],
      "transition": {},
      "duration_ms": 9000
    },
    {
      "id": "scene-006",
      "order": 5,
      "title": "Règles de Dérivation Courantes",
      "blocks": [
        {
          "id": "block-015",
          "type": "paragraph",
          "order": 0,
          "style": {},
          "content": "Quelques règles essentielles :",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-016",
          "type": "formula",
          "order": 1,
          "style": {},
          "content": "(c)' = 0 \\quad (constante)",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-017",
          "type": "formula",
          "order": 2,
          "style": {},
          "content": "(x)' = 1",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-018",
          "type": "formula",
          "order": 3,
          "style": {},
          "content": "(e^x)' = e^x",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-019",
          "type": "formula",
          "order": 4,
          "style": {},
          "content": "(\\ln x)' = \\frac{1}{x}",
          "visible": true,
          "position": {},
          "animation": {}
        }
      ],
      "transition": {},
      "duration_ms": 10000
    },
    {
      "id": "scene-007",
      "order": 6,
      "title": "Exercice d'Application",
      "blocks": [
        {
          "id": "block-020",
          "type": "exercise",
          "order": 0,
          "style": {},
          "content": "Calculez la dérivée de la fonction suivante :",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-021",
          "type": "formula",
          "order": 1,
          "style": {},
          "content": "g(x) = 5x^3 - 4x + 7",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-022",
          "type": "paragraph",
          "order": 2,
          "style": {},
          "content": "Prenez quelques instants pour réfléchir.",
          "visible": true,
          "position": {},
          "animation": {}
        }
      ],
      "transition": {},
      "duration_ms": 7000
    },
    {
      "id": "scene-008",
      "order": 7,
      "title": "Correction de l'Exercice",
      "blocks": [
        {
          "id": "block-023",
          "type": "correction",
          "order": 0,
          "style": {},
          "content": "Pour g(x) = 5x³ - 4x + 7 :",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-024",
          "type": "formula",
          "order": 1,
          "style": {},
          "content": "g'(x) = \\frac{d}{dx}(5x^3) - \\frac{d}{dx}(4x) + \\frac{d}{dx}(7)",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-025",
          "type": "formula",
          "order": 2,
          "style": {},
          "content": "g'(x) = 5 \\cdot 3x^{3-1} - 4 \\cdot 1 + 0",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-026",
          "type": "formula",
          "order": 3,
          "style": {},
          "content": "g'(x) = 15x^2 - 4",
          "visible": true,
          "position": {},
          "animation": {}
        }
      ],
      "transition": {},
      "duration_ms": 8000
    },
    {
      "id": "scene-009",
      "order": 8,
      "title": "Applications des Dérivées",
      "blocks": [
        {
          "id": "block-027",
          "type": "paragraph",
          "order": 0,
          "style": {},
          "content": "Les dérivées sont utilisées pour :",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-028",
          "type": "paragraph",
          "order": 1,
          "style": {},
          "content": "- Optimisation (minima/maxima)",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-029",
          "type": "paragraph",
          "order": 2,
          "style": {},
          "content": "- Étude de variations de fonctions",
          "visible": true,
          "position": {},
          "animation": {}
        },
        {
          "id": "block-030",
          "type": "paragraph",
          "order": 3,
          "style": {},
          "content": "- Physique (vitesse, accélération)",
          "visible": true,
          "position": {},
          "animation": {}
        }
      ],
      "transition": {},
      "duration_ms": 7000
    }
  ],
